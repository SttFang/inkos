# InkOS Environment Configuration
# Copy to .env and fill in your values

# =============================================================================
# Main LLM Provider (required for normal operation)
# =============================================================================

# LLM Provider (openai, anthropic, custom)
INKOS_LLM_PROVIDER=openai

# API Base URL (OpenAI-compatible endpoint)
INKOS_LLM_BASE_URL=https://api.openai.com/v1

# API Key
INKOS_LLM_API_KEY=sk-your-key-here

# Model name
INKOS_LLM_MODEL=gpt-4o

# Optional tuning
# INKOS_LLM_TEMPERATURE=0.7
# INKOS_LLM_MAX_TOKENS=8192
# INKOS_LLM_THINKING_BUDGET=0          # Anthropic extended thinking budget
# INKOS_LLM_API_FORMAT=chat            # chat (default) or responses (OpenAI Responses API)
# INKOS_LLM_HEADERS={"X-Custom":"v"}   # JSON object or "Key: Value" string

# =============================================================================
# Smoke Test Credentials (optional, used only by pnpm smoke:llm)
# =============================================================================
# Fill in any subset you want to test. Missing variants are skipped.
# Costs are tiny (~$0.005 per variant per run) when using the suggested models.

# --- OpenAI official (Chat Completions) ---
# INKOS_SMOKE_OPENAI_API_KEY=sk-...
# INKOS_SMOKE_OPENAI_BASE_URL=https://api.openai.com/v1
# INKOS_SMOKE_OPENAI_MODEL=gpt-4o-mini

# --- OpenAI official (Responses API variant) ---
# Usually shares the key with OPENAI above, but allowed to differ.
# INKOS_SMOKE_OPENAI_RESPONSES_API_KEY=sk-...
# INKOS_SMOKE_OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
# INKOS_SMOKE_OPENAI_RESPONSES_MODEL=gpt-4o-mini

# --- Anthropic official ---
# INKOS_SMOKE_ANTHROPIC_API_KEY=sk-ant-...
# INKOS_SMOKE_ANTHROPIC_BASE_URL=https://api.anthropic.com
# INKOS_SMOKE_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- OpenAI-compatible proxy (the main source of production bugs) ---
# Pick ONE of the suggested providers and fill in.
#   • OpenRouter:  https://openrouter.ai/api/v1  (single key, routes to many models, most quirks)
#   • DeepSeek:    https://api.deepseek.com/v1   (cheap; reasoning_content multi-turn quirk)
#   • Moonshot:    https://api.moonshot.cn/v1    (CN; Kimi models)
#   • SiliconFlow: https://api.siliconflow.cn/v1 (CN; many open models)
#   • Ollama:      http://localhost:11434/v1     (local; no key required)
# INKOS_SMOKE_OPENAI_CUSTOM_API_KEY=
# INKOS_SMOKE_OPENAI_CUSTOM_BASE_URL=
# INKOS_SMOKE_OPENAI_CUSTOM_MODEL=
# INKOS_SMOKE_OPENAI_CUSTOM_LABEL=             # free-form label for test reports (e.g. "openrouter-claude-haiku")

# =============================================================================
# Notifications (optional)
# =============================================================================

INKOS_TELEGRAM_BOT_TOKEN=
INKOS_TELEGRAM_CHAT_ID=
INKOS_FEISHU_WEBHOOK_URL=
INKOS_WECOM_WEBHOOK_URL=
